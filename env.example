# If using ODBC Driver 17, add: Driver=ODBC Driver 17 for SQL Server
# SQLAlchemy example: mssql+pyodbc://server:port/db?driver={ODBC Driver 18 for SQL Server}
SQL_CONNECTION_STRING=
